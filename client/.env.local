# Frontend Environment Configuration (Vite)
# NOTE: In Vite, all client-exposed environment variables must start with VITE_

# API Base URL:
# - In local development: /api (automatically proxied by Vite to http://localhost:3000/api)
# - For standalone or external backend: VITE_API_URL=http://localhost:3000/api
# - In production: set VITE_API_URL to your deployed backend URL (e.g., https://your-backend.vercel.app/api)
VITE_API_URL=/api
